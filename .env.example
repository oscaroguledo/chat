# Copy to .env and fill in your values

# PostgreSQL
POSTGRES_PASSWORD=chatapp_secret_change_in_prod

# Redis
REDIS_PASSWORD=redis_secret_change_in_prod

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_secret_change_in_prod

# JWT — MUST be min 64 characters in production
JWT_SECRET=super_secret_jwt_key_change_in_prod_must_be_at_least_64_chars_long_abcdefghijk
JWT_EXPIRY_MS=86400000
JWT_REFRESH_EXPIRY_MS=604800000

# App
APP_BASE_URL=http://localhost
